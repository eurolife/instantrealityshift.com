---
import ImageMod from './ImageMod.astro';
import { Icon } from 'astro-icon/components';

const testimonial = Astro.props.testimonial;
const aosDelay = Astro.props.aosDelay as number;
---

<div
  class="p-7 rounded-2xl border border-border/80 overflow-hidden"
  data-aos="fade-up-sm"
  data-aos-delay={aosDelay}
>
  <div class="flex items-center mb-4 relative">
    <div class="absolute inset-0 translate-x-1/3 translate-y-1/3 -z-10">
      <div class="flex items-center justify-center rotate-45 w-full h-full">
        <div
          class="w-2/6 h-5/6 bg-secondary/90 blur-[50px] rounded-full -translate-x-24 translate-x-0 transition-all duration-500"
        >
        </div>
        <div
          class="w-2/6 h-5/6 bg-tertiary/90 blur-[50px] rounded-full -translate-x-16 translate-x-0 transition-all duration-500"
        >
        </div>
      </div>
    </div>
    <Icon
      name="l-quote"
      width={60}
      height={60}
      class="text-primary/50 group-hover:text-white transition-all duration-500 opacity-[65%]"
    />
    <div class="ml-3">
      <p class="font-bold text-lg">{testimonial.name}</p>
      <p class="text-text/80">{testimonial.designation}</p>
    </div>
  </div>
  <p class="text-white">"{testimonial.content}"</p>
</div>
