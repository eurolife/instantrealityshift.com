          <div class="mt-8 grid gap-4 items-stretch md:grid-cols-2 xl:grid-cols-3">
            {!filterProducts(category.id).length && (
              <p class="my-8">Audios coming soon!</p>
            )}
            {filterProducts(category.id).map((item) => (
              <ProductCard info={item} />
            ))}
          </div>
